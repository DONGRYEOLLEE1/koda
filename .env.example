PRIMARY=local

LOCAL_API_KEY=nothing
LOCAL_OPENAI_BASE_URL=http://llm-host.example.com:8081/v1
LOCAL_MODEL_NAME=Qwen3.6-35B-A3B-UD-Q5_K_XL.gguf

# reasoning 제어 방식 — 엔드포인트가 실제로 존중하는 파라미터 계열을 고른다. 기본값 off 는 아무것도
# 보내지 않아 어떤 엔드포인트에서도 거절당하지 않는다(정식 OpenAI API 는 알 수 없는 필드를 400 으로 막는다).
#   off    : 미전송 — DeepSeek, gpt-4o 등 reasoning 파라미터를 모르는 엔드포인트
#   qwen   : llama.cpp — chat_template_kwargs.enable_thinking + thinking_budget_tokens
#   effort : vLLM·OpenAI gpt-5 계열 — reasoning_effort
#REASONING_STYLE=qwen
# effort 스타일에서 reasoning 을 켤 때의 등급(low|medium|high). 끌 때는 항상 none 을 보낸다.
#REASONING_EFFORT=medium

# 구조화 출력 방식 고정(json_schema|function_calling). 빈 값이면 강제력 순으로 탐색하는데, 미지원
# 방식은 프로세스마다 첫 턴에 400 을 한 번 맞는다. 엔드포인트가 정해져 있으면 지정해 그 왕복을 없앤다.
#STRUCTURED_METHOD=function_calling

# qwen 스타일에서 reader·explore 에 차등 적용할 reasoning 예산.
#THINKING_BUDGET_READER=1024
#THINKING_BUDGET_EXPLORE=512

# 나가는 프롬프트 토큰 예산(HistoryTrim 이 이 값으로 턴 누적을 결정론 절단). llama.cpp n_ctx 절반 수준 권장.
#CONTEXT_BUDGET_TOKENS=64000
# 자동 승인할 읽기 전용 MCP 이름(쉼표 구분). 기본 빈 값=모든 MCP HITL. 쓰기·SSRF 가능 MCP 는 넣지 말 것.
#KODA_MCP_AUTO_APPROVE=web_search,query-docs

# 폴백: 로컬 미가용 시 OpenAI API
FALLBACK_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# Langfuse 추적 (docker-compose 로 배포한 인스턴스). 키는 compose 의 LANGFUSE_INIT_* 와 일치.
LANGFUSE_HOST=http://localhost:28900
LANGFUSE_PUBLIC_KEY=pk-lf-a1b2c3d4-0000-4000-8000-000000000001
LANGFUSE_SECRET_KEY=sk-lf-a1b2c3d4-0000-4000-8000-000000000002
