# 모든 값은 선택이다. 아무 설정 없이 실행하면 DeepSeek(OpenAI 호환) API 를 쓰며, 그때 필요한 건 키 하나뿐이다:
#   export OPENAI_API_KEY=sk-...
# 이 파일 대신 환경변수로 넘겨도 되고, 파일을 쓰려면 CWD/.env 또는 ~/.config/koda/.env 에 둔다 (환경변수가 파일보다 우선).

# --- 엔드포인트 ---
# 기본 엔드포인트 (OpenAI 호환). 다른 서비스면 URL·모델명만 바꾼다.
OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.deepseek.com
#OPENAI_MODEL_NAME=deepseek-v4-flash

# 로컬 llama.cpp 를 주로 쓰려면 PRIMARY=local. 그때 위 API 는 로컬이 죽었을 때의 폴백이 된다(FALLBACK_ENABLED).
#PRIMARY=local
#LOCAL_OPENAI_BASE_URL=http://localhost:8080/v1
#LOCAL_MODEL_NAME=Qwen3.6-35B-A3B-UD-Q5_K_XL.gguf
#LOCAL_API_KEY=nothing
#FALLBACK_ENABLED=true

# --- 모델 동작 ---
# reasoning 제어 방식. 기본 effort 는 DeepSeek·gpt-5 계열용(reasoning_effort). DeepSeek 는 아무것도 안 보내면
# thinking 이 켜진 채라 구조화 출력이 400 으로 깨지므로 off 로 바꾸지 말 것. reasoning 파라미터를 모르는
# 모델(gpt-4o 등)은 off, llama.cpp 는 qwen(enable_thinking + thinking_budget_tokens).
#REASONING_STYLE=effort
#REASONING_EFFORT=medium
# qwen 스타일에서 reader·explore 에 차등 적용할 reasoning 예산.
#THINKING_BUDGET_READER=1024
#THINKING_BUDGET_EXPLORE=512
# 구조화 출력 방식. 기본 function_calling 은 DeepSeek·OpenAI 용. llama.cpp 는 문법 강제가 되는 json_schema 로 바꾼다.
# 빈 값이면 강제력 순으로 탐색하되, 미지원 방식에서 프로세스당 400 을 한 번 맞는다.
#STRUCTURED_METHOD=json_schema
# 나가는 프롬프트 토큰 예산. llama.cpp n_ctx 절반 수준 권장.
#CONTEXT_BUDGET_TOKENS=64000
# 자동 승인할 읽기 전용 MCP 이름(쉼표 구분). 쓰기·SSRF 가능 MCP 는 넣지 말 것.
#KODA_MCP_AUTO_APPROVE=web_search,query-docs

# --- 추적 (선택) ---
# docker compose 로 띄운 langfuse. 키는 compose 의 LANGFUSE_INIT_* 와 일치. 비우면 추적을 끈다.
#LANGFUSE_HOST=http://localhost:28900
#LANGFUSE_PUBLIC_KEY=pk-lf-a1b2c3d4-0000-4000-8000-000000000001
#LANGFUSE_SECRET_KEY=sk-lf-a1b2c3d4-0000-4000-8000-000000000002
