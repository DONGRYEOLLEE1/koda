# 모든 값은 선택이다. 모델명과 그 provider 의 키만 있으면 뜬다:
#   export DEEPSEEK_API_KEY=...                       # 기본 모델 deepseek-v4-flash
#   export MODEL=gpt-5.6-terra OPENAI_API_KEY=sk-...  # 모델명만 바꾸면 OpenAI 로 전환
# 이 파일 대신 환경변수로 넘겨도 되고, 파일을 쓰려면 CWD/.env 또는 ~/.config/koda/.env 에 둔다 (환경변수가 파일보다 우선).

# --- 모델·엔드포인트 ---
# 모델명으로 provider 를 유추해 base_url·reasoning·구조화 출력 방식을 맞춘다 (gpt-*/o* → OpenAI, deepseek-* → DeepSeek).
#MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
#OPENAI_API_KEY=
# 유추가 안 되는 모델(자체 호스팅 등)은 base_url 을 직접 준다. 명시한 값은 항상 프로필보다 우선.
#OPENAI_BASE_URL=https://api.deepseek.com

# 로컬 서버를 주로 쓰려면 PRIMARY=local. 그때 위 API 는 로컬이 죽었을 때의 폴백이 된다(FALLBACK_ENABLED).
# 상세는 providers/llama.cpp.md(llama-server), providers/inner-vllm.md(사내 vLLM · LiteLLM 게이트웨이).
#PRIMARY=local
#LOCAL_OPENAI_BASE_URL=http://localhost:8080/v1      # 사내 vLLM: http://127.0.0.1:4000/v1 (WSL 안) · http://llm-gateway.example.com:4000/v1
#LOCAL_MODEL_NAME=Qwen3.6-35B-A3B-UD-Q5_K_XL.gguf     # 사내 vLLM: qwen3.8-27b
#LOCAL_API_KEY=nothing                                # 사내 vLLM: LiteLLM Virtual Key (REASONING_EFFORT 는 low·medium·xhigh 만)
#FALLBACK_ENABLED=true

# --- 모델 동작 ---
# reasoning 제어 방식. 비우면 프로필(OpenAI·DeepSeek 모두 effort=reasoning_effort). reasoning 파라미터를 모르는
# 모델(gpt-4o 등)은 off, llama.cpp 는 qwen(enable_thinking + thinking_budget_tokens). DeepSeek 는 off 로 두면
# thinking 이 켜진 채라 구조화 출력이 400 으로 깨진다.
#REASONING_STYLE=effort
#REASONING_EFFORT=medium
# qwen 스타일에서 reader·explore 에 차등 적용할 reasoning 예산.
#THINKING_BUDGET_READER=1024
#THINKING_BUDGET_EXPLORE=512
# 구조화 출력 방식. 비우면 프로필(OpenAI=json_schema, DeepSeek=function_calling). llama.cpp 는 json_schema 를 지정.
# auto 는 강제력 순 탐색이되 미지원 방식에서 프로세스당 400 을 한 번 맞는다.
#STRUCTURED_METHOD=json_schema
# 나가는 프롬프트 토큰 예산. llama.cpp n_ctx 절반 수준 권장.
#CONTEXT_BUDGET_TOKENS=131072
# 자동 승인할 읽기 전용 MCP 이름(쉼표 구분). 쓰기·SSRF 가능 MCP 는 넣지 말 것.
#KODA_MCP_AUTO_APPROVE=web_search,query-docs

# --- 추적 (선택) ---
# docker compose 로 띄운 langfuse. 키는 compose 의 LANGFUSE_INIT_* 와 일치. 비우면 추적을 끈다.
#LANGFUSE_HOST=http://localhost:28900
#LANGFUSE_PUBLIC_KEY=pk-lf-a1b2c3d4-0000-4000-8000-000000000001
#LANGFUSE_SECRET_KEY=sk-lf-a1b2c3d4-0000-4000-8000-000000000002
